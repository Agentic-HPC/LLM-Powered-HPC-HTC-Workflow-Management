# --- App ---
ENV=development
DEBUG=true

# --- Security ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Docker Compose: postgresql+psycopg2://postgres:postgres@db:5432/hpc_platform
# Local/manual:   postgresql+psycopg2://postgres:postgres@localhost:5432/hpc_platform
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hpc_platform

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM Provider: "groq" (fast cloud, free tier) or "openai" ---
LLM_PROVIDER=groq

# --- Groq (only used when LLM_PROVIDER=groq) ---
# Get a key at https://console.groq.com/keys - NEVER commit a real key here
# or paste it into chat/code. This file is a template; put the real value
# only in your local, git-ignored .env.
# Groq's free/standard-tier model list changes over time (see
# https://console.groq.com/docs/models). If you get a 404 "model not
# found/no access" error, run:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# to see what your key can actually use.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- OpenAI (only used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Real Apache Spark ---
# "local[*]" = real Spark engine using every core on this machine.
# Point at spark://host:7077 for a real standalone cluster.
SPARK_MASTER_URL=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8

# --- Real multiprocessing MapReduce ---
MAPREDUCE_MAX_WORKERS=0

# --- Datasets ---
DATASET_DIR=data
